<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>solon-ai-example</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>model-example</artifactId>
    <name>Model Example</name>
    <description>Provider / model configuration management example (web config page + dynamic model resolution)</description>

    <dependencies>
        <!-- LLM Core Starter（复用 ChatModel 自动装配 / EnvFileLoader 约定） -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>llm-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- OpenAPI 3 / Swagger 文档（版本由父 POM dependencyManagement 管理） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-ui</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- MyBatis-Plus（Spring Boot 2 线 starter，JDK8 兼容）：mc_provider / mc_model 持久层 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>3.5.5</version>
        </dependency>

        <!-- MySQL 驱动（版本由 Spring Boot 2.7.18 BOM 管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <!-- 纯库模块：被 ai-starter 引用自动装配；独立启动仅限 IDE 运行 main()，不打包可执行 jar -->
</project>
