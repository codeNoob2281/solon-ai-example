<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 多模块聚合：llm-core / llm-chat-example / rag-example / agent-example -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>solon-ai-example</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Solon AI Example</name>
    <description>Minimal AI chat example: Spring Boot 2.7.18 + Solon AI 4.1.0</description>

    <modules>
        <module>llm-core</module>
        <module>llm-chat-example</module>
        <module>rag-example</module>
        <module>agent-example</module>
    </modules>

    <properties>
        <java.version>8</java.version>
        <solon-ai.version>4.1.0</solon-ai.version>
        <!-- solon-ai 4.0.6 内部 pin 的 milvus-sdk-java 版本，保持一致 -->
        <milvus-sdk.version>2.6.3</milvus-sdk.version>
        <springdoc.version>1.8.0</springdoc.version>
        <!-- JSON 序列化统一 fastjson2（依赖声明在基础模块 llm-core，随依赖传递） -->
        <fastjson2.version>2.0.62</fastjson2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
              Solon AI UI 协议适配（solon-ai-ui 子项目，Central 已发布 4.1.0）
              将 ChatModel/Agent 事件流包装为 Vercel AI SDK UI Message Stream Protocol v1 SSE，
              供 @ai-sdk/react 的 useChat 直接消费（依赖 solon-ai-core，传递 solon-web-sse）
            -->
            <dependency>
                <groupId>org.noear</groupId>
                <artifactId>solon-ai-ui-aisdk</artifactId>
                <version>${solon-ai.version}</version>
            </dependency>

            <!--
              OpenAPI 3 / Swagger 文档（springdoc 1.x 是最后支持 Spring Boot 2.x + Java 8 的分支）
              Swagger UI: http://localhost:{port}/swagger-ui.html
              OpenAPI JSON: http://localhost:{port}/v3/api-docs
            -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- JSON 序列化框架：全仓库统一 fastjson2（版本集中管理，依赖在 llm-core 引入） -->
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>