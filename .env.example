# AI 对话配置（OpenAI 兼容协议）
# 优先级：.env > application.yml > 默认值

# OpenAI 兼容 API 地址（不要带 /v1/chat/completions，Solon AI 会自动拼接）
# 常见端点：
#   OpenAI 官方:  https://api.openai.com/v1
#   Ollama:       http://localhost:11434/v1
#   LM Studio:    http://localhost:1234/v1
#   vLLM:         http://your-vllm-host:8000/v1
AI_API_URL=http://localhost:1234/v1

# API 密钥（OpenAI 兼容服务通常需要，Ollama 可随意填）
AI_API_KEY=sk-your-api-key

# 模型名称
AI_MODEL=gpt-3.5-turbo

# 服务端口（llm-chat-example 默认 8080，rag-example 默认 8081）
SERVER_PORT=8080

# ===== RAG 示例（rag-example）=====

# 嵌入模型（Ollama bge-m3：apiUrl 用完整地址，非 api_base）
RAG_EMBEDDING_API_URL=http://127.0.0.1:11434/api/embed
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=bge-m3:latest
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_STANDARD=ollama
RAG_EMBEDDING_BATCH_SIZE=10

# 文本分块参数
RAG_CHUNK_SIZE=500
RAG_MIN_CHUNK_CHARS=300

# Milvus 连接
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DB_NAME=

# 知识库 Collection 名（不能用 -）
MILVUS_COLLECTION=solon_rag_demo