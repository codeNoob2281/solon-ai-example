# AI 对话配置（OpenAI 兼容协议）
# 优先级：.env > application.yml > 默认值

# OpenAI 兼容 API 地址（不要带 /v1/chat/completions，Solon AI 会自动拼接）
# 常见端点：
#   OpenAI 官方:  https://api.openai.com/v1
#   Ollama:       http://localhost:11434/v1
#   LM Studio:    http://localhost:1234/v1
#   vLLM:         http://your-vllm-host:8000/v1
AI_API_URL=http://localhost:1234/v1

# API 密钥（OpenAI 兼容服务通常需要，Ollama 可随意填）
AI_API_KEY=sk-your-api-key

# 模型名称
AI_MODEL=gpt-3.5-turbo

# 模型请求/响应日志开关（ChatModel 请求/响应 DEBUG 输出，三个模块共用）
AI_CHAT_LOGGING_ENABLED=false

# 服务端口（llm-chat-example 默认 8080，rag-example 默认 8081）
SERVER_PORT=8080

# ===== 对话示例（llm-chat-example）=====

# 对话记忆存储目录（相对路径，基于应用运行目录）
AI_CHAT_MEMORY_DIR=temp/chat-memory

# 交互窗口大小：模型交互时只取最近 N 条消息作为上下文（文件保留完整历史）
AI_CHAT_WINDOW_SIZE=20

# ===== RAG 示例（rag-example）=====

# 嵌入模型（Ollama bge-m3：apiUrl 用完整地址，非 api_base）
RAG_EMBEDDING_API_URL=http://127.0.0.1:11434/api/embed
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=bge-m3:latest
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_STANDARD=ollama
RAG_EMBEDDING_BATCH_SIZE=10

# 嵌入请求超时秒数 + 失败重试（超时/瞬断/限流自动重试；总尝试次数含首次，退避按 2^n 递增）
RAG_EMBEDDING_TIMEOUT_SECONDS=60
RAG_EMBEDDING_RETRY_MAX_ATTEMPTS=3
RAG_EMBEDDING_RETRY_BACKOFF_MILLIS=1000

# 父子分段参数（父块存 MySQL 分块表，检索命中后进 LLM 上下文；子块存 Milvus 做向量检索）
RAG_PARENT_CHUNK_SIZE=1000
RAG_PARENT_MIN_CHARS=600
RAG_CHILD_CHUNK_SIZE=200
RAG_CHILD_MIN_CHARS=50

# 检索策略（RagRetrievalStrategy 实现标识；默认 parent-child = 子块向量检索 + 父块映射）
# 可选：mysql-fulltext（关键词全文检索）/ hybrid-rrf（向量 + 关键词 RRF 加权融合）
RAG_SEARCH_STRATEGY=parent-child

# 混合检索（hybrid-rrf）参数：向量/关键词 RRF 加权权重，默认 0.6 / 0.4（原始权重，不归一化）
RAG_SEARCH_VECTOR_WEIGHT=0.6
RAG_SEARCH_KEYWORD_WEIGHT=0.4
# 混合检索候选倍数：各来源候选条数 = limit × 该倍数（RRF 需更大候选池做跨来源重排）
RAG_SEARCH_CANDIDATE_MULTIPLIER=3

# MySQL 连接（知识库文档表/父块表；URL 带 createDatabaseIfNotExist=true，库不存在自动创建）
MYSQL_URL=jdbc:mysql://localhost:3306/rag_demo?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Milvus 连接
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DB_NAME=

# 知识库 Collection 名（不能用 -）
MILVUS_COLLECTION=solon_rag_demo

# 文档并行入库线程池（单线程处理最小维度 = 单个文档；并行度参考嵌入服务并发能力）
RAG_INGEST_CORE_POOL_SIZE=4
RAG_INGEST_MAX_POOL_SIZE=8
RAG_INGEST_QUEUE_CAPACITY=256
RAG_INGEST_KEEP_ALIVE_SECONDS=60
RAG_INGEST_THREAD_NAME_PREFIX=rag-ingest-
RAG_INGEST_ALLOW_CORE_THREAD_TIMEOUT=true