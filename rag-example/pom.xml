<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>solon-ai-example</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>rag-example</artifactId>
    <name>RAG Example</name>
    <description>Traditional RAG example: document loading, chunking and Milvus ingestion</description>

    <dependencies>
        <!-- LLM Core Starter（复用 ChatModel / EnvFileLoader 约定） -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>llm-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- OpenAPI 3 / Swagger 文档（版本由父 POM dependencyManagement 管理） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-ui</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
          Solon AI 聚合包（solon-ai-core + 各方言，含 openai/ollama EmbeddingDialect）
          说明：不再引入 solon-ai-repo-milvus（其 Collection 结构固定，无法扩展 parent_id 独立字段），
          改为项目内自定义 MilvusChildRepository 直接基于 milvus-sdk-java 操作。
        -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-ai</artifactId>
            <version>${solon-ai.version}</version>
        </dependency>

        <!-- Milvus Java SDK v2（MilvusClientV2 / ConnectConfig / CreateCollectionReq 等），版本与 solon-ai 内部 pin 一致 -->
        <dependency>
            <groupId>io.milvus</groupId>
            <artifactId>milvus-sdk-java</artifactId>
            <version>${milvus-sdk.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- MyBatis-Plus（Spring Boot 2 线 starter，JDK8 兼容）：kb_document / kb_chunk 持久层 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>3.5.5</version>
        </dependency>

        <!-- MySQL 驱动（版本由 Spring Boot 2.7.18 BOM 管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Markdown 文档加载器 -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-ai-load-markdown</artifactId>
            <version>${solon-ai.version}</version>
        </dependency>

        <!-- HTML 文档加载器 -->
        <dependency>
            <groupId>org.noear</groupId>
            <artifactId>solon-ai-load-html</artifactId>
            <version>${solon-ai.version}</version>
        </dependency>
    </dependencies>

    <!-- 纯库模块：被 ai-starter 引用自动装配；独立启动仅限 IDE 运行 main()，不打包可执行 jar -->
</project>
